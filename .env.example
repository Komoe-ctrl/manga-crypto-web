# Origine de crypto-api, SANS `/api` : le client généré ajoute lui-même le préfixe de chaque route.
# Ces variables sont figées à la compilation (`next build`) : les changer demande de recompiler.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Origine du WebSocket (par défaut : celle de l'API, avec ws:// ou wss://). Le chemin /api/ws est ajouté par le code.
NEXT_PUBLIC_WS_URL=ws://localhost:3001
